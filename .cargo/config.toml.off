# Link with LLVM's linker instead of MSVC's.
#
# `link.exe` is single-threaded and is where a Bevy debug build spends most of
# its time: the executable is a gigabyte of object code, and the default linker
# walks it alone. `rust-lld` ships with the toolchain and links the same input
# with threads. Measured on this machine, incremental build after a one-line
# change: 40.5 s with `link.exe`, 12.6 s with `rust-lld`.
#
# `rust-lld.exe` is not on `PATH` by default; `scripts/env.ps1` adds the
# toolchain's `bin` directory, which is also what makes this resolve.
[target.x86_64-pc-windows-msvc]
linker = "rust-lld.exe"
